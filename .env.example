# ── Connections (required) ─────────────────────────────────────────────
RPC_URL=https://your-rpc-node.example
GRPC_URL=https://your-geyser-grpc.example
X_TOKEN=your-geyser-token

# ── Trading (optional; without WALLET_KEYPAIR_PATH the bot only watches) ─
# JSON keypair file, e.g. created with `solana-keygen new -o bot.json`
WALLET_KEYPAIR_PATH=
# wallet = trade your own SOL, flash_loan = borrow it (see FLASH_LOAN_PROVIDER)
FUNDING_MODE=wallet
# false = simulate only (safe). true = really send transactions.
SEND_TRANSACTIONS=false
# Dry-run each trade on the RPC node before sending. Adds a round trip; off by default.
RPC_SIMULATION=false
MAX_TRADE_INPUT_LAMPORTS=1000000000
MIN_PROFIT_LAMPORTS=10000
PRIORITY_FEE_MICROLAMPORTS_PER_CU=10000
COMPUTE_UNIT_LIMIT=400000
# Leave empty to send through RPC instead of a Jito bundle
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=10000
MAX_STATE_AGE_SLOTS=150
MAX_STREAM_SILENCE_MS=2000
SLIPPAGE_TOLERANCE_BPS=0

# ── Flash loan (only when FUNDING_MODE=flash_loan) ─────────────────────
# jupiter (default, fee set on-chain, currently 0 bps) or kamino
FLASH_LOAN_PROVIDER=jupiter
# Cost estimate. Jupiter: 0. The bot refuses to start if Jupiter's live fee is higher.
# Kamino: 1 (check the reserve).
FLASH_LOAN_FEE_BPS=0
# Only for FLASH_LOAN_PROVIDER=kamino
KAMINO_LENDING_MARKET=
KAMINO_SOL_RESERVE=

# ── Address lookup tables (needed for flash loans: ~35 accounts) ───────
# Create one with `cargo run -- create-lookup-table`, then paste the printed address.
# Comma-separated for several. Jupiter's flash loan is compute-heavy: raise
# COMPUTE_UNIT_LIMIT (e.g. 600000) if simulation runs out of compute.
ADDRESS_LOOKUP_TABLES=

# ── Logs ───────────────────────────────────────────────────────────────
# Same lines as the terminal, kept in a file because the stream scrolls away.
# Default is logs/arb-bot.log. Set empty to write only to the terminal.
# LOG_FILE=logs/arb-bot.log
# LOG_FILE=
# true = also print every tick-array update (very chatty)
LOG_VERBOSE=false

# ── Rbot visualizer (dashboard/) ───────────────────────────────────────
# true = stream JSON events to ws://127.0.0.1:8787/ws and write logs/dashboard-events.jsonl
DASHBOARD=false
# DASHBOARD_PORT=8787
# Raise Orca's *quoted* price by this many basis points so a round trip can be
# built and simulated on video day. Sending is forced off. 0 = real prices only.
DEMO_PRICE_SHIFT_BPS=0
