# ── Connections (required) ─────────────────────────────────────────────
RPC_URL=https://solana-rpc.publicnode.com
GRPC_URL=https://solana-yellowstone-grpc.publicnode.com:443
X_TOKEN=ea24649d80024cb7e78781d6cd7fbfd27a0354468377ff792efd282c2a188fe8

# ── Trading (optional; without WALLET_KEYPAIR_PATH the bot only watches) ─
# JSON keypair file, e.g. created with `solana-keygen new -o bot.json`
WALLET_KEYPAIR_PATH=bot-keypair.json
# wallet = trade your own SOL, flash_loan = borrow it (see FLASH_LOAN_PROVIDER)
FUNDING_MODE=flash_loan
# false = simulate only (safe). true = really send transactions.
# Kept false until a flash-loan simulation succeeds; flip to true afterwards.
SEND_TRANSACTIONS=false
# Dry-run each trade on the RPC node before sending.
RPC_SIMULATION=true
MAX_TRADE_INPUT_LAMPORTS=50000000
MIN_PROFIT_LAMPORTS=10000
PRIORITY_FEE_MICROLAMPORTS_PER_CU=10000
# Jupiter's flash loan CPIs into its liquidity layer; 400000 may be too low.
COMPUTE_UNIT_LIMIT=600000
# Leave empty to send through RPC instead of a Jito bundle
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=10000
MAX_STATE_AGE_SLOTS=150
MAX_STREAM_SILENCE_MS=2000
SLIPPAGE_TOLERANCE_BPS=0

# ── Flash loan (only when FUNDING_MODE=flash_loan) ─────────────────────
# jupiter (fee set on-chain, currently 0 bps) or kamino (1 bp)
FLASH_LOAN_PROVIDER=jupiter
# Cost estimate for the selected provider. Each fee stays with its lender,
# so switching FLASH_LOAN_PROVIDER cannot reuse the other lender's number.
# The bot refuses to start if Jupiter's live fee is higher than this.
JUPITER_FLASH_LOAN_FEE_BPS=0
KAMINO_FLASH_LOAN_FEE_BPS=1
# Only for FLASH_LOAN_PROVIDER=kamino
KAMINO_LENDING_MARKET=
KAMINO_SOL_RESERVE=

# ── Address lookup tables (required for flash loans) ───────────────────
# Run `cargo run -- create-lookup-table` and paste the printed address here.
ADDRESS_LOOKUP_TABLES=A9ArrMQWP9ke8XbqHjNazQ1tcMzs6otBE1MCCJoL43B8

